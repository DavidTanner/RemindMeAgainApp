# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# --- Secrets & signing material: never commit these ---
# Environment / config files with secrets
.env
.env.*
!.env.example
*.secret
secrets/

# Android signing
key.properties
*.keystore
*.jks

# iOS / Apple signing
*.p8
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
AuthKey_*.p8

# Firebase / Google service configs (can embed project API keys)
google-services.json
GoogleService-Info.plist

# Obfuscation symbol files from `--split-debug-info`
/symbols/
*.symbols
